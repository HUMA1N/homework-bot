# Скопируй этот файл в .env и впиши токен, который выдал @BotFather.
# Файл .env в git не попадает — не публикуй токен никуда.
BOT_TOKEN=

# Во сколько присылать список на сегодня и вечернее напоминание (ЧЧ:ММ).
MORNING_TIME=07:30
EVENING_TIME=20:00

# Часовой пояс. Если не указан — берётся часовой пояс компьютера.
# Пример: TIMEZONE=Europe/Moscow
TIMEZONE=
